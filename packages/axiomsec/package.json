{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.4.5",
  "name": "axiomsec",
  "description": "AI agent harness for AppSec and pentest operations",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MontaCoder/axiomsec"
  },
  "homepage": "https://github.com/MontaCoder/axiomsec",
  "bugs": {
    "url": "https://github.com/MontaCoder/axiomsec/issues"
  },
  "keywords": [
    "cybersecurity",
    "appsec",
    "pentest",
    "security",
    "agent",
    "terminal"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "prepare": "effect-language-service patch || true",
    "typecheck": "tsgo --noEmit",
    "build": "bun run script/build.ts",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "db": "bun drizzle-kit"
  },
  "bin": {
    "axiomsec": "./bin/axiomsec"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#db": "./src/storage/db.bun.ts",
    "#pty": "./src/terminal/pty.bun.ts",
    "#hono": "./src/server/adapter.bun.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.84.2",
    "@axiomsec/script": "workspace:*",
    "@axiomsec/shared": "workspace:*",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/semver": "^7.5.8",
    "@types/turndown": "5.0.5",
    "@types/which": "3.0.4",
    "@types/yargs": "17.0.33",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vscode-languageserver-types": "3.17.5",
    "zod-to-json-schema": "3.24.5"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.16.1",
    "@ai-sdk/amazon-bedrock": "4.0.96",
    "@ai-sdk/anthropic": "3.0.71",
    "@ai-sdk/azure": "3.0.54",
    "@ai-sdk/gateway": "3.0.104",
    "@ai-sdk/google": "3.0.64",
    "@ai-sdk/google-vertex": "4.0.112",
    "@ai-sdk/groq": "3.0.31",
    "@ai-sdk/openai": "3.0.53",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/provider": "3.0.12",
    "@ai-sdk/provider-utils": "4.0.33",
    "@ai-sdk/xai": "3.0.83",
    "@aws-sdk/credential-providers": "3.993.0",
    "@axiomsec/plugin": "workspace:*",
    "@axiomsec/sdk": "workspace:*",
    "@clack/prompts": "1.0.0-alpha.1",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@npmcli/arborist": "9.4.0",
