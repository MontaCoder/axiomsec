{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@axiomsec/sdk",
  "version": "0.5.2",
  "description": "SDK for the axiomsec AI agent harness for AppSec and pentest operations",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/MontaCoder/axiomsec"
  },
  "homepage": "https://github.com/MontaCoder/axiomsec",
  "bugs": {
    "url": "https://github.com/MontaCoder/axiomsec/issues"
  },
  "keywords": [
    "axiomsec",
    "sdk",
    "cybersecurity",
    "security",
    "agent"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/v2/index.ts",
    "./client": "./src/v2/client.ts",
    "./server": "./src/v2/server.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/server": "./src/v2/server.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}
