  },
  "keywords": [
    "cybersecurity",
    "appsec",
    "pentest",
    "security",
    "agent",
    "terminal"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "license": "AGPL-3.0-or-later",
  "prettier": {
    "semi": false,
    "printWidth": 120
