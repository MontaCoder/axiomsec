{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "axiomsec",
  "description": "Terminal-native AI cyber operator harness",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/axiomsec --conditions=browser src/index.ts",
    "lint": "oxlint",
    "typecheck": "bun run --filter '*' --parallel typecheck",
    "test": "bun test --timeout 60000"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.4",
      "@types/cross-spawn": "6.0.6",
      "ulid": "3.0.2",
      "@types/node": "22.20.5",
      "@types/semver": "7.8.0",
      "@tsconfig/node22": "22.0.6",
      "@tsconfig/bun": "1.0.11",
      "diff": "9.0.0",
      "drizzle-kit": "1.0.0-beta.22",
      "drizzle-orm": "1.0.0-beta.22",
      "effect": "4.0.6",
      "ai": "7.0.151",
      "cross-spawn": "7.0.6",
      "hono": "4.13.13",
      "hono-openapi": "1.5.0",
      "fuzzysort": "3.1.0",
      "semver": "7.8.5",
      "typescript": "7.0.2",
      "zod": "4.6.7",
      "remeda": "2.53.0",
      "tailwindcss": "4.1.11",
      "solid-js": "1.9.17"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "bun-pty": "0.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MontaCoder/axiomsec"
  },
  "homepage": "https://github.com/MontaCoder/axiomsec",
  "bugs": {
    "url": "https://github.com/MontaCoder/axiomsec/issues"
  },
  "keywords": [
    "cybersecurity",
    "appsec",
    "pentest",
    "security",
    "agent",
    "terminal"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "AGPL-3.0-or-later",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "bun-pty",
    "esbuild"
  ],
  "overrides": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@ai-sdk/provider": "4.0.33",
    "@ai-sdk/provider-utils": "5.0.67",
    "@ai-sdk/gateway": "4.0.124",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "node-gyp": {
      "undici": "6.29.1"
    },
    "gitlab-ai-provider": {
      "zod": "4.6.7"
    }
  }
}
